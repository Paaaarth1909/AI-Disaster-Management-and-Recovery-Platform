# ==========================================
# AI Disaster Management System - Environment Variables
# ==========================================

# 1. Google Gemini AI API Configuration
# Get your API key for free from: https://aistudio.google.com/app/apikey
VITE_GEMINI_API_KEY=your_gemini_api_key_here
VITE_GEMINI_MODEL=gemini-1.5-flash

# 2. Mapbox Configuration (for 2D Interactive Maps & Layers)
# Get your public access token for free from: https://account.mapbox.com/
VITE_MAPBOX_TOKEN=your_mapbox_public_token_here

# 3. Supabase Configuration (for PostgreSQL + PostGIS backend & Real-time alerts)
# Create a free project at: https://supabase.com/
# Run the migration file in 'supabase/migrations/20250315171444_dark_rice.sql' in the Supabase SQL Editor.
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

